{
	"$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
	"files": {
		"ignoreUnknown": true,
		"includes": ["src/**/*.ts", "test/**/*.ts", "package.json", "tsconfig.json"]
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off"
			},
			"suspicious": {
				"noExplicitAny": "off"
			}
		}
	}
}
